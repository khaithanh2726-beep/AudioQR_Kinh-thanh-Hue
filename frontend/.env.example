# URL HTTPS thật của trang bắt đầu dùng cho một QR chung
VITE_PUBLIC_START_URL=
# Bật riêng để rà bản trích OSM và năm vùng đề xuất; không có nghĩa là đã duyệt
VITE_MAP_PREVIEW=false
# Nền OSM tiêu chuẩn như mẫu UI. offline chỉ là bản trích giản lược để kiểm riêng.
VITE_MAP_BASEMAP=osm
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
